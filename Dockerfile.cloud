# Portable container for HumxnMed — ready for Google Cloud Run / AWS / Fly.io (a HIPAA-eligible host
# with a signed BAA). Named ".cloud" on purpose so Railway (which uses a root "Dockerfile") ignores it
# and your live deploy is unaffected. When you migrate: `docker build -f Dockerfile.cloud -t humxnmed .`
FROM python:3.12-slim

# Build tools only during install (kept out of the final layer where practical).
RUN apt-get update && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install deps first for better layer caching.
COPY requirements.txt ./
RUN pip install --no-cache-dir --upgrade pip && pip install --no-cache-dir -r requirements.txt

# App code.
COPY . .

# Cloud Run/App Runner inject PORT (default 8080). Bind to it.
ENV PORT=8080
EXPOSE 8080
CMD ["sh", "-c", "python -m uvicorn backend.server:app --host 0.0.0.0 --port ${PORT}"]
